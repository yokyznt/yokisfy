{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yokisfy",
  "version": "0.7.4",
  "identifier": "dev.yokyznt.yokisfy",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; media-src 'self' https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Música libre en alta calidad",
    "license": "GPL-3.0-or-later",
    "category": "Music",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNjlCQjE5QkVCN0FCODQKUldTRXE3ZStHYnRwUzcrNDY1V3Q0RWFENW92TGV4L0Z4UlhTZVNtZG5CSkFHS1RlUHFLMmMva2QK",
      "endpoints": [
        "https://github.com/yokyznt/yokisfy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
