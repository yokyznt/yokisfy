{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yokisfy",
  "version": "0.1.0",
  "identifier": "dev.yokyznt.yokisfy",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Música libre en alta calidad",
    "license": "GPL-3.0-or-later",
    "category": "Music"
  }
}
